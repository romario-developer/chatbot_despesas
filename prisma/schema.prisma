generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  TRANSFER
  OTHER
}

model User {
  id          Int            @id @default(autoincrement())
  telegramId  String?        @unique
  telegramChatId String?     @unique
  name        String?
  email       String?        @unique
  passwordHash String?
  mustChangePassword Boolean @default(true)
  createdAt   DateTime       @default(now())
  categories  Category[]
  expenses    Expense[]
  assistantConversations AssistantConversation[]
  drafts      ExpenseDraft[]
  session     UserSession?
  planning    Planning?
  linkCodes   TelegramLinkCode[]
  cards       Card[]
  payments    CardPayment[]
  installmentGroups InstallmentGroup[]
  credits     Credit[]
}

model Category {
  id             Int            @id @default(autoincrement())
  userId         Int
  name           String
  normalizedName String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
  drafts   ExpenseDraft[]
  rules    CategoryRule[]
  memories CategoryMemory[]

  @@unique([userId, normalizedName])
  @@index([userId, createdAt])
}

model AssistantActionLog {
  id             Int      @id @default(autoincrement())
  conversationId String   @unique
  lastEntity     String
  lastEntityId   Int
  updatedAt      DateTime @updatedAt
}

model AssistantConversation {
  conversationId String @id
  userId         Int
  pendingDraft   Json?
  pendingQuestion String @default("none")
  lastExpenseId  Int?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  brand      String
  limit      Int
  closingDay Int
  dueDay     Int
  color      String   @default("#4F46E5")
  textColor  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
  expenseDrafts ExpenseDraft[]
  payments CardPayment[]
  installmentGroups InstallmentGroup[]

  @@index([userId, createdAt])
}

model CategoryRule {
  id         Int      @id @default(autoincrement())
  categoryId Int
  keywords   String
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model CategoryMemory {
  id             Int      @id @default(autoincrement())
  normalizedText String   @unique
  categoryId     Int
  updatedAt      DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Expense {
  id            Int           @id @default(autoincrement())
  userId        Int
  categoryId    Int
  cardId        Int?
  amountCents   Int
  paymentMethod PaymentMethod @default(OTHER)
  categorySource String?
  description   String
  date          DateTime
  source        String
  rawText       String
  installmentCurrent Int?
  installmentTotal   Int?
  purchaseLabel      String?
  postedMonth        String?
  createdAt     DateTime      @default(now())
  installmentGroupId String?
  installmentIndex   Int  @default(1)
  installmentsTotal  Int  @default(1)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  card     Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  installmentGroup InstallmentGroup? @relation(fields: [installmentGroupId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, date])
  @@index([cardId])
  @@index([cardId, date])
  @@index([userId, cardId, date])
  @@index([date])
  @@index([installmentGroupId])
}

model ExpenseDraft {
  id          String    @id @default(cuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  description String
  date        DateTime
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  cardId      Int?
  paymentMethod PaymentMethod @default(OTHER)
  card        Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  rawText     String
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([cardId])
}

model InstallmentGroup {
  id                 String    @id @default(cuid())
  userId             Int
  cardId             Int
  descriptionBase    String
  totalAmountCents   Int
  installmentsTotal  Int
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId, cardId])
}

model CardPayment {
  id          Int      @id @default(autoincrement())
  userId      Int
  cardId      Int
  amountCents Int
  paymentDate DateTime
  cycleEnd    DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, cardId, cycleEnd])
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String?
  draftId   String?
  resetToken String?
  resetTokenExpiresAt DateTime?
  updatedAt DateTime @updatedAt
}

model Planning {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelegramLinkCode {
  code      String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Credit {
  id          Int      @id @default(autoincrement())
  userId      Int
  amountCents Int
  description String
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
}
