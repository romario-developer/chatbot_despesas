generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  TRANSFER
  OTHER
}

model User {
  id          Int            @id @default(autoincrement())
  telegramId  String?        @unique
  telegramChatId String?     @unique
  name        String?
  email       String?        @unique
  passwordHash String?
  mustChangePassword Boolean @default(true)
  createdAt   DateTime       @default(now())
  categories  Category[]
  expenses    Expense[]
  drafts      ExpenseDraft[]
  session     UserSession?
  planning    Planning?
  linkCodes   TelegramLinkCode[]
  cards       Card[]
}

model Category {
  id             Int            @id @default(autoincrement())
  userId         Int
  name           String
  normalizedName String
  createdAt      DateTime       @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
  drafts   ExpenseDraft[]

  @@unique([userId, normalizedName])
  @@index([userId, createdAt])
}

model Card {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  brand      String
  limit      Int
  closingDay Int
  dueDay     Int
  color      String   @default("#4F46E5")
  textColor  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
  expenseDrafts ExpenseDraft[]
  payments CardPayment[]

  @@index([userId, createdAt])
}

model Expense {
  id            Int           @id @default(autoincrement())
  userId        Int
  categoryId    Int
  cardId        Int?
  amountCents   Int
  paymentMethod PaymentMethod @default(OTHER)
  description   String
  date          DateTime
  source        String
  rawText       String
  createdAt     DateTime      @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  card     Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, date])
  @@index([cardId])
  @@index([userId, cardId, date])
  @@index([date])
}

model ExpenseDraft {
  id          String    @id @default(cuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  description String
  date        DateTime
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  cardId      Int?
  paymentMethod PaymentMethod @default(OTHER)
  card        Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  rawText     String
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([cardId])
}

model CardPayment {
  id          Int      @id @default(autoincrement())
  userId      Int
  cardId      Int
  amountCents Int
  paymentDate DateTime
  cycleEnd    DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, cardId, cycleEnd])
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String?
  draftId   String?
  resetToken String?
  resetTokenExpiresAt DateTime?
  updatedAt DateTime @updatedAt
}

model Planning {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelegramLinkCode {
  code      String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
